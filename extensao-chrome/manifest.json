{
  "manifest_version": 3,
  "name": "Mercadão O.S.",
  "short_name": "Mercadão O.S.",
  "version": "1.0.0",
  "description": "Veja e aprove O.S. pendentes sem precisar abrir o site inteiro.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mercadão O.S.",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "cookies"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
